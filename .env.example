# Development-only knobs to demonstrate optimistic updates and rollback.
# Copy to .env.local, change the values, then restart `pnpm dev`.

# Probability (0 to 1) that a cart save fails. 1 = every save fails.
VITE_FAKE_FAILURE_RATE=0

# Extra delay, in milliseconds, before each cart save.
VITE_FAKE_LATENCY_MS=0
